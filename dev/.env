# Application config
RUNTIME__APP_ENV=dev
SERVICE__NAME=comfy-shell-v3
SERVICE__TITLE=ComfyUI Shell
SERVICE__API_PREFIX=/v1
SECURITY__SERVICE_API_KEY=<replace-me>
SECURITY__DISABLE_AUTH=true
SECURITY__ALLOWED_ORIGINS=http://127.0.0.1:8700,http://localhost:8700
DATABASE__URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25432/fastapi_lite
DATABASE__SSL=false
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
REDIS__ENABLED=false
REDIS__URL=redis://127.0.0.1:26379/0
STORAGE__BACKEND=disabled
STORAGE__LOCAL_PATH=storage/objects
STORAGE__ENDPOINT=
STORAGE__BUCKET=
STORAGE__REGION=
STORAGE__ACCESS_KEY_ID=
STORAGE__ACCESS_KEY_SECRET=
HTTP_CLIENT__TIMEOUT_SECONDS=5
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__ACCESS_LOG_ENABLED=true
OBSERVABILITY__HEALTH_ACCESS_LOG=false

# ComfyUI shell config
COMFY__WORKSPACE_DIR=/data/wangqiao/comfy-shell-v3-workspace
COMFY__REPO_URL=https://github.com/Comfy-Org/ComfyUI.git
COMFY__HOST=127.0.0.1
COMFY__PORT=8188
COMFY__PYTHON=python
COMFY__PYPI_INDEX_URL=
COMFY__TORCH_PACKAGES=
COMFY__TORCH_INDEX_URL=
COMFY__EXTRA_ARGS=--novram
COMFY__CUDA_VISIBLE_DEVICES=1
COMFY__HF_ENDPOINT=https://hf-mirror.com
COMFY__HF_TOKEN=

# Launcher config
API_HOST=127.0.0.1
API_PORT=8700
API_HOST_PORT=8700
COMPOSE_PROJECT_NAME=comfy-shell-v3
POSTGRES_DB=fastapi_lite
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379
